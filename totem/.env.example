# Copia este archivo como .env y ajusta los valores.

# Clave para firmar las cookies de sesión.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/totem

# Pool de conexiones
DB_POOL_MIN=1
DB_POOL_MAX=5

# Sesión: 8 horas de inactividad
SESSION_LIFETIME=28800
# Ponlo en True cuando la app corra detrás de HTTPS
SESSION_COOKIE_SECURE=False

# Freno a intentos de login
MAX_INTENTOS_LOGIN=5
BLOQUEO_LOGIN_SEGUNDOS=300
