# Copia este archivo como .env y ajusta los valores.

# Clave para firmar las cookies de sesión.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/totem

# Pool de conexiones
DB_POOL_MIN=1
DB_POOL_MAX=5

# Sesión: 8 horas de inactividad
SESSION_LIFETIME=28800
# Ponlo en True cuando la app corra detrás de HTTPS
SESSION_COOKIE_SECURE=False

# Freno a intentos de login
MAX_INTENTOS_LOGIN=5
BLOQUEO_LOGIN_SEGUNDOS=300

# ─── Correo saliente ───────────────────────────────────────────────
# Si dejas estas líneas vacías, el sistema no ofrece el envío por
# correo. Todo lo demás funciona igual.
#
# Gmail (provisional, mientras no haya dominio propio):
#   MAIL_PASSWORD NO es la contraseña de tu Gmail. Es una "contraseña
#   de aplicación" de 16 letras, que solo aparece si la cuenta tiene
#   verificación en dos pasos activada. Se saca en:
#   Cuenta de Google → Seguridad → Verificación en dos pasos →
#   Contraseñas de aplicaciones.
#   Gmail permite unos 500 envíos al día y siempre muestra como
#   remitente la propia cuenta, aunque pongas otro nombre.
#
# Brevo u otro proveedor (cuando exista el dominio):
#   MAIL_SERVIDOR=smtp-relay.brevo.com
#   MAIL_USUARIO y MAIL_PASSWORD son los que entrega el panel.
#   Ahí sí MAIL_REMITENTE puede ser recibos@tudominio.com.

MAIL_SERVIDOR=smtp.gmail.com
MAIL_PUERTO=587
MAIL_TLS=True
MAIL_USUARIO=tu-cuenta@gmail.com
MAIL_PASSWORD=las-16-letras-de-la-contrasena-de-aplicacion
MAIL_REMITENTE=tu-cuenta@gmail.com
MAIL_NOMBRE_REMITENTE=Totem Climb Gym
