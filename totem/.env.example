# Copia este archivo como .env y ajusta los valores.

# Clave para firmar las cookies de sesión.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
# Firma las cookies de sesión. Quien la conoce puede fabricar una
# cookie que diga "empleado 1, rol ADMIN" y entrar sin contraseña, así
# que el sistema NO ARRANCA sin una propia.
#
# Genere la suya en ESTA máquina, y péguela acá abajo:
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Una distinta por cada lugar donde corre el sistema: una en su
# máquina y otra en la computadora del gimnasio, generada allá. No la
# escriba a mano, no la copie de otro lado, no la suba al repositorio.
#
# Dejar el texto de abajo tal cual no sirve: está en el repositorio y
# el sistema lo rechaza. Si alguna vez la cambia, todos tienen que
# volver a iniciar sesión; no se pierde ningún dato.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/totem

# Pool de conexiones
DB_POOL_MIN=1
DB_POOL_MAX=5

# Sesión: 8 horas de inactividad
SESSION_LIFETIME=28800
# Ponlo en True cuando la app corra detrás de HTTPS
SESSION_COOKIE_SECURE=False

# Freno a intentos de login
MAX_INTENTOS_LOGIN=5
BLOQUEO_LOGIN_SEGUNDOS=300

# ─── Correo saliente ───────────────────────────────────────────────
# Si dejas estas líneas vacías, el sistema no ofrece el envío por
# correo. Todo lo demás funciona igual.
#
# Gmail (provisional, mientras no haya dominio propio):
#   MAIL_PASSWORD NO es la contraseña de tu Gmail. Es una "contraseña
#   de aplicación" de 16 letras, que solo aparece si la cuenta tiene
#   verificación en dos pasos activada. Se saca en:
#   Cuenta de Google → Seguridad → Verificación en dos pasos →
#   Contraseñas de aplicaciones.
#   Gmail permite unos 500 envíos al día y siempre muestra como
#   remitente la propia cuenta, aunque pongas otro nombre.
#
# Brevo u otro proveedor (cuando exista el dominio):
#   MAIL_SERVIDOR=smtp-relay.brevo.com
#   MAIL_USUARIO y MAIL_PASSWORD son los que entrega el panel.
#   Ahí sí MAIL_REMITENTE puede ser recibos@tudominio.com.

MAIL_SERVIDOR=smtp.gmail.com
MAIL_PUERTO=587
MAIL_TLS=True
MAIL_USUARIO=tu-cuenta@gmail.com
MAIL_PASSWORD=las-16-letras-de-la-contrasena-de-aplicacion
MAIL_REMITENTE=tu-cuenta@gmail.com
MAIL_NOMBRE_REMITENTE=Totem Climb Gym

# ─── Quién emite los comprobantes electrónicos ─────────────────────
# "sri"      este sistema firma y manda al SRI
# "externa"  los emite otro sistema (Contífico, desde el Excel diario).
#            Este sistema cobra y entrega el comprobante interno; no
#            manda nada al SRI.
#
# Un solo emisor a la vez. Si los dos emiten, el gimnasio termina con
# dos comprobantes autorizados por la misma venta.
FACTURACION_ELECTRONICA=externa

# ─── Rebotes: saber cuáles correos NO llegaron ─────────────────────
# Que el correo salga no quiere decir que haya llegado. Si la
# dirección está mal escrita, el aviso vuelve a este buzón minutos
# después, cuando ya nadie está mirando.
#
# Con esto configurado, "python -m scripts.revisar_rebotes" lee ese
# buzón y marca la factura y el cliente, para que alguien le pregunte
# el correo bueno la próxima vez que venga.
#
# Con Gmail es la misma cuenta y la misma contraseña de aplicación
# del envío. Solo lee: no borra ni marca como leído.
#
# Si se deja vacío, los correos que no llegan no se detectan y todo
# lo demás funciona igual.
IMAP_SERVIDOR=imap.gmail.com
IMAP_PUERTO=993
IMAP_USUARIO=tu-cuenta@gmail.com
IMAP_PASSWORD=las-16-letras-de-la-contrasena-de-aplicacion
IMAP_CARPETA=INBOX

# ─── Facturación electrónica (SRI) ─────────────────────────────────
# Mientras estas líneas estén vacías, el sistema emite solo sus
# comprobantes internos y no intenta facturar al SRI.
#
# EL CERTIFICADO NO VA DENTRO DEL REPOSITORIO. Guárdelo en una
# carpeta aparte (por ejemplo C:\totem\certificado.p12). Si alguna
# vez se sube a Git hay que revocarlo y comprar otro: no se arregla
# cambiando una clave, como sí se hace con la de la base de datos.
# "1" certificación (pruebas), "2" producción. En certificación los
# comprobantes NO tienen validez tributaria, así que el RIDE sale con
# una marca de agua que lo dice.
SRI_AMBIENTE=1

SRI_P12_RUTA=C:\totem\certificado.p12
SRI_P12_CLAVE=la-clave-del-certificado

# Datos del emisor, tal como constan en el RUC.
SRI_RUC=1790012345001
SRI_RAZON_SOCIAL=RAZON SOCIAL COMO CONSTA EN EL RUC
SRI_NOMBRE_COMERCIAL=Totem Climb Gym
SRI_DIR_MATRIZ=Direccion de la matriz
SRI_DIR_ESTABLECIMIENTO=Direccion del establecimiento

# Establecimiento y punto de emisión.
#
# IMPORTANTE: si el gimnasio ya factura con otra herramienta, este
# punto de emisión tiene que ser DISTINTO del que usa esa
# herramienta. Dos sistemas numerando sobre el mismo punto producen
# secuenciales repetidos, y el SRI los rechaza. El punto nuevo se
# solicita en SRI en Línea → Facturación Electrónica → Autorización →
# Solicitud de emisión.
SRI_ESTABLECIMIENTO=001
SRI_PUNTO_EMISION=002

# SI solo si el gimnasio está obligado a llevar contabilidad.
SRI_OBLIGADO_CONTABILIDAD=NO

# SI si el RUC dice "RIMPE Emprendedor": en ese caso la factura debe
# llevar la leyenda del régimen.
SRI_CONTRIBUYENTE_RIMPE=NO

# RUC de quien desarrolla el sistema, obligatorio desde el 26 de
# septiembre de 2026 (anexo 26 de la ficha técnica 2.34). Para un
# sistema hecho para uso interno y que no se comercializa no está
# claro si corresponde. Déjelo vacío hasta confirmarlo con el
# contador: vacío, el campo no se escribe en la factura.
SRI_RUC_PROVEEDOR=

# Secuencial que usa scripts/sri_prueba.py en el ambiente de
# certificación. Va alto a propósito, para no pisar la numeración
# real del gimnasio.
SRI_SECUENCIAL_PRUEBA=900000001
